---
import { ArrowRight, Snail, CalendarClock, Building2 } from '@lucide/astro';
import Logo from './Logo.astro';
import GitHubIcon from './GitHubIcon.astro';

const strip = [
  {
    icon: Snail,
    title: 'Throttle, don’t block',
    text: 'Distracting sites crawl. Docs, mail and work sites run at full speed.',
  },
  {
    icon: CalendarClock,
    title: 'Routines start themselves',
    text: 'Focus slots begin on schedule. Two skips a week, no more.',
  },
  {
    icon: Building2,
    title: 'A city that remembers',
    text: 'Finished sessions raise buildings. Giving in levels them.',
  },
];
---

<section id="top" class="relative overflow-hidden">
  <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="container-page relative pt-20 pb-16 text-center sm:pt-24">
    <Logo size={80} class="mx-auto rounded-[1.25rem] shadow-xl shadow-night/25" />

    <p
      class="mx-auto mt-8 inline-flex items-center gap-2 rounded-full border border-border bg-card/70 px-3 py-1 text-xs text-muted-foreground sm:text-sm"
    >
      <span class="size-1.5 rounded-full bg-brand"></span>
      A focus app for Linux that is hard to get around
    </p>

    <h1 class="mx-auto mt-6 max-w-4xl font-display text-[2.6rem] leading-[1.05] font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
      Focus builds a city.
      <span class="block text-brand">Giving in tears it down<span class="text-foreground">.</span></span>
    </h1>

    <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-muted-foreground text-pretty">
      DeepWork slows distracting sites to a crawl at the network layer, starts focus sessions on a schedule, and
      raises a building in a 3D city for every session you finish. Quit early and you watch it come down.
    </p>

    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="https://github.com/Sagyam/DeepWork" class="btn btn-primary">
        <GitHubIcon />
        View on GitHub
      </a>
      <a href="#start" class="btn btn-outline">
        Quick start
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
    </div>

    <figure class="mx-auto mt-16 max-w-[52rem]">
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-2xl shadow-night/20">
        <div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
          <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
          <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
          <span class="size-2.5 rounded-full bg-muted-foreground/25"></span>
          <span class="ml-3 font-mono text-xs text-muted-foreground">deepwork-ui · hamlet → metropolis</span>
        </div>
        <video
          class="block aspect-[8/5] w-full bg-night"
          width="720"
          height="450"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/demo-poster.webp"
          aria-label="Set a timer and watch a hamlet grow into a city; surrender and a tower collapses; then the stats and site lists in settings."
        >
          <source src="/demo.mp4" type="video/mp4" />
        </video>
      </div>
      <figcaption class="mt-3 text-xs text-muted-foreground">
        Captured from the app. A fresh install starts with an empty field: you build the rest.
      </figcaption>
    </figure>

    <div class="mx-auto mt-14 grid max-w-[52rem] overflow-hidden rounded-xl border border-border bg-card text-left sm:grid-cols-3">
      {
        strip.map(({ icon: Icon, title, text }, i) => (
          <div class:list={['flex gap-3 p-6', i > 0 && 'border-t border-border sm:border-t-0 sm:border-l']}>
            <Icon class="mt-0.5 size-5 shrink-0 text-brand" aria-hidden="true" />
            <div>
              <h3 class="font-display font-semibold">{title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{text}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

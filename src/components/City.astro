---
import { Flame, Mountain, Zap, Hammer } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';

// Grades from world.rs: session length picks the kind of building.
const grades = [
  { name: 'Cottage', when: 'any length', h: 26, w: 34, roof: 'gable' },
  { name: 'Shop', when: '25 min', h: 40, w: 36, roof: 'flat' },
  { name: 'Apartments', when: '50 min', h: 70, w: 34, roof: 'flat' },
  { name: 'Office tower', when: '90 min', h: 104, w: 30, roof: 'flat' },
  { name: 'Landmark', when: '3 h', h: 140, w: 28, roof: 'spire' },
];
const base = 160;

const tiers = [
  ['Hamlet', '0 h'],
  ['Town', '10 h'],
  ['City', '50 h'],
  ['Metropolis', '200 h'],
];

const costs = [
  {
    icon: Flame,
    tag: 'severe',
    tagClass: 'bg-loss-soft text-loss',
    title: 'Surrender',
    text: 'The building under construction collapses into rubble and fire spreads to the three nearest. The time doesn’t count and the streak resets.',
  },
  {
    icon: Mountain,
    tag: 'major',
    tagClass: 'bg-loss-soft text-loss',
    title: 'Tamper',
    text: 'Flush the firewall or edit a qdisc and an earthquake hits your biggest district. The rules are back within a second anyway.',
  },
  {
    icon: Zap,
    tag: 'minor',
    tagClass: 'bg-brand-soft text-brand',
    title: 'Bypass attempts',
    text: 'A refused sudo, a jump of the wall clock or a SOCKS tunnel cracks your newest building.',
  },
  {
    icon: Hammer,
    tag: 'repair',
    tagClass: 'bg-pass-soft text-pass',
    title: 'Coming back',
    text: 'Every finished session repairs damage, worst first, and builds on the oldest rubble. Twice as fast on a three-day streak.',
  },
];
---

<section id="city" class="border-y border-border bg-band py-24 sm:py-28" aria-labelledby="city-title">
  <div class="container-page">
    <SectionHeading eyebrow="The city" id="city-title">
      <Fragment slot="title">Every session is a building.</Fragment>
      The city is folded from the daemon’s ledger each time it’s drawn. Nothing is stored that the app could edit, so the
      only way to grow it is to focus, and the only way to lose it is to give in.
    </SectionHeading>

    <div class="mt-14 grid gap-8 lg:grid-cols-[1.1fr_1fr]">
      <div class="card p-6 sm:p-8">
        <p class="font-display text-xs font-semibold tracking-[0.16em] uppercase text-muted-foreground">Longer sessions build bigger</p>
        <svg viewBox="0 0 500 200" class="mt-6 w-full" role="img" aria-labelledby="grades-title">
          <title id="grades-title">Building grades: cottage for any session, shop from 25 minutes, apartments from 50, an office tower from 90, a landmark from 3 hours</title>
          <line x1="0" y1={base} x2="500" y2={base} class="stroke-border" stroke-width="2"></line>
          {
            grades.map((g, i) => {
              const cx = 50 + i * 100;
              const x = cx - g.w / 2;
              const top = base - g.h;
              const rows = Math.floor((g.h - 14) / 12);
              const cols = g.w > 32 ? 3 : 2;
              const gap = g.w / (cols + 1);
              return (
                <g>
                  {g.roof === 'gable' && <path d={`M${x - 3} ${top} L${cx} ${top - 16} L${x + g.w + 3} ${top} Z`} class="fill-muted-foreground/60" />}
                  {g.roof === 'spire' && (
                    <>
                      <path d={`M${cx - 6} ${top} L${cx} ${top - 22} L${cx + 6} ${top} Z`} class="fill-brand" />
                      <rect x={cx - 1} y={top - 30} width="2" height="10" class="fill-brand" />
                    </>
                  )}
                  <rect x={x} y={top} width={g.w} height={g.h} rx="1.5" class="fill-foreground/85" />
                  {Array.from({ length: rows }, (_, r) =>
                    Array.from({ length: cols }, (_, c) => (
                      <rect
                        x={x + gap * (c + 1) - 2.5}
                        y={top + 8 + r * 12}
                        width="5"
                        height="6"
                        class={(r * 7 + c * 3 + i) % 4 === 0 ? 'fill-background/30' : 'fill-brand'}
                      />
                    )),
                  )}
                  <text x={cx} y={base + 20} text-anchor="middle" class="fill-foreground font-display text-[13px] font-semibold">
                    {g.name}
                  </text>
                  <text x={cx} y={base + 36} text-anchor="middle" class="fill-muted-foreground font-mono text-[11px]">
                    {g.when}
                  </text>
                </g>
              );
            })
          }
        </svg>

        <p class="mt-10 font-display text-xs font-semibold tracking-[0.16em] uppercase text-muted-foreground">Focused hours grow the settlement</p>
        <ol class="mt-5 grid grid-cols-4">
          {
            tiers.map(([name, hours], i) => (
              <li class="relative">
                <div class="flex items-center">
                  <span class:list={['relative z-10 size-3 rounded-full border-2 border-brand', i === 0 ? 'bg-brand' : 'bg-card']} />
                  {i < tiers.length - 1 && <span class="h-0.5 flex-1 bg-gradient-to-r from-brand to-brand/30" />}
                </div>
                <p class="mt-3 font-display text-sm font-semibold">{name}</p>
                <p class="font-mono text-xs text-muted-foreground">{hours}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {
          costs.map(({ icon: Icon, tag, tagClass, title, text }) => (
            <div class="card p-5">
              <div class="flex items-center justify-between">
                <Icon class="size-5 text-muted-foreground" aria-hidden="true" />
                <span class:list={['rounded px-1.5 py-0.5 font-mono text-[0.7rem]', tagClass]}>{tag}</span>
              </div>
              <h3 class="mt-4 font-display font-semibold">{title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

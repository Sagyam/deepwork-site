---
interface Props {
  eyebrow: string;
  id?: string;
}
const { eyebrow, id } = Astro.props;
---

<div class="max-w-3xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-4 font-display text-3xl font-bold tracking-tight text-balance sm:text-[2.5rem] sm:leading-[1.1]">
    <slot name="title" />
  </h2>
  <div class="mt-5 text-lg leading-relaxed text-muted-foreground text-pretty">
    <slot />
  </div>
</div>

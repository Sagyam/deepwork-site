---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Tour from '../components/Tour.astro';
import City from '../components/City.astro';
import HardToCheat from '../components/HardToCheat.astro';
import Safety from '../components/Safety.astro';
import Book from '../components/Book.astro';
import Architecture from '../components/Architecture.astro';
import QuickStart from '../components/QuickStart.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="DeepWork · Focus builds a city. Giving in tears it down."
  description="A focus app for Linux that is hard to get around. Distracting sites slow to a crawl at the network layer, routines start sessions on their own, and every early quit costs you a building in a 3D city."
>
  <Nav />
  <main id="main">
    <Hero />
    <Why />
    <HowItWorks />
    <Tour />
    <City />
    <Book />
    <HardToCheat />
    <Safety />
    <Architecture />
    <QuickStart />
  </main>
  <Footer />
</Base>
